# ==========================================================
# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# ==========================================================

# Option 1: Full Supabase Connection String (Recommended)
# Replace with your Supabase Transaction Pooler or Session Pooler connection string:
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Option 2: Individual Connection Parameters (Alternative)
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# ==========================================================
# Server Configuration
# ==========================================================
PORT=3000
